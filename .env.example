# ============================================================
# Enterprise Ticket Agent — 环境变量模板
# 复制为 .env 后填入真实值，docker-compose up -d 即可一键启动
# ============================================================

# ── 数据库 (PostgreSQL) ─────────────────────────────────────
POSTGRES_USER=ticketuser
POSTGRES_PASSWORD=ticketpass
POSTGRES_DB=ticketdb
# compose 内部自动拼接；本地开发可改为 sqlite
DATABASE_URL=postgresql+asyncpg://ticketuser:ticketpass@postgres:5432/ticketdb
LANGGRAPH_STRICT_MSGPACK=true

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── 大模型 (Google Gemini) ──────────────────────────────────
GOOGLE_API_KEY=<your-google-api-key>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=gemini
# Optional per-node provider chain, JSON encoded.
LLM_NODE_ROUTES_JSON=
# Optional USD per 1M tokens: {"provider:model":{"input":0.1,"output":0.4}}
LLM_PRICE_CATALOG_JSON=
# {"answer_policy":{"policy-v2":"...template..."}}
PROMPT_VERSIONS_JSON=
# {"answer_policy":{"stable":"builtin-v1","canary":"policy-v2","percent":10}}
PROMPT_ROLLOUTS_JSON=
# Optional full Policy-as-Code document for deterministic canary rollout.
POLICY_CANARY_JSON=
POLICY_CANARY_PERCENT=0
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=4
RAG_CANDIDATE_MULTIPLIER=4
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=60
RAG_RERANK_ENABLED=true
TOOL_CIRCUIT_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_RESET_SECONDS=30
APPROVAL_ESCALATION_WORKER_ENABLED=false
APPROVAL_ESCALATION_POLL_SECONDS=30
LONG_TERM_MEMORY_RETENTION_DAYS=730
AGENT_JOB_WORKER_ENABLED=false
AGENT_JOB_POLL_SECONDS=1
AGENT_JOB_MAX_ATTEMPTS=3
AGENT_JOB_WORKER_ID=agent-job-worker

# ── 可观测性 - Langfuse (可选) ──────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 邮件通知 (Gmail, 可选) ──────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── 应用配置 ────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
ADMIN_API_KEY=change-me-and-share-with-frontend-server-only
FRONTEND_ORIGIN=http://localhost:3000
AGENT_PUBLIC_URL=http://localhost:8000
RISK_THRESHOLD_AMOUNT=500.0
SIMULATE_DATABASE_DOWN=false
DEFAULT_TENANT_ID=TENANT-DEMO-COMMERCE

# --- Data Security / KMS -------------------------------------------------
# Generate a high-entropy secret for local KMS emulation. Production can use
# KMS_PROVIDER=http with an HTTPS Vault/cloud-KMS gateway.
FIELD_ENCRYPTION_KEY=change-me-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY_ID=local-dev-v1
KMS_PROVIDER=local
KMS_ENDPOINT=
KMS_BEARER_TOKEN=
PII_DEFAULT_RETENTION_DAYS=365

# --- Integration Workers ------------------------------------------------
# Keep embedded workers disabled when the independent worker service runs.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_POLL_SECONDS=1
OUTBOX_WORKER_ID=compose-integration-worker
RECONCILIATION_WORKER_ENABLED=false
RECONCILIATION_WORKER_POLL_SECONDS=5
A2A_WORKER_ENABLED=false
A2A_WORKER_POLL_SECONDS=1
A2A_WORKER_ID=compose-a2a-worker
# Comma-separated tenant ids handled by the independent worker.
A2A_WORKER_TENANTS=TENANT-DEMO-COMMERCE
# Production callback hosts must be explicitly allowlisted.
A2A_ALLOWED_CALLBACK_HOSTS=
A2A_DEFAULT_CALLBACK_URL=
# Development fallback only. Production Joule integration should use IAS App2App trust.
A2A_CALLBACK_BEARER_TOKEN=

# --- SAP / ERP Connector -------------------------------------------------
SAP_CONNECTOR_MODE=mock
SAP_BASE_URL=
SAP_AUTH_TYPE=api_key
SAP_API_KEY=
SAP_USERNAME=
SAP_PASSWORD=
SAP_BEARER_TOKEN=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=
SAP_SCOPE=
SAP_VERIFY_TLS=true
SAP_READ_ONLY=true
SAP_SHADOW_WRITES=true
SAP_TIMEOUT_SECONDS=15
SAP_MAX_RETRIES=2
SAP_CIRCUIT_FAILURE_THRESHOLD=3
SAP_CIRCUIT_RESET_SECONDS=30
SAP_OPERATION_PATHS_JSON={}

# --- ERP Agent SLO -------------------------------------------------------
AGENT_SLO_SUCCESS_RATE=0.99
AGENT_SLO_P95_LATENCY_MS=5000
AGENT_SLO_MAX_COMPENSATION_RATE=0.02

# ── 前端 ────────────────────────────────────────────────────
# 浏览器端请求后端的地址（构建时内联）
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
