{
  "id": "refund",
  "name": "Refund Support",
  "description": "Existing refund, order lookup, risk control, HITL approval, and notification workflow.",
  "workflow": "refund_workflow",
  "status": "active",
  "owner": "Customer Operations",
  "business_domain": "After-sales",
  "logic_module": "app.agent.nodes.classifier.classify_intent_node",
  "logic_file": "backend/app/agent/graph.py",
  "sla_minutes": 30,
  "tags": ["HITL", "Risk Control", "Refund"],
  "intents": ["refund", "query_order", "query_policy", "track_logistics", "escalate", "other"],
  "keywords": [
    "退款",
    "退货",
    "退钱",
    "订单",
    "物流",
    "政策",
    "规则",
    "refund",
    "order",
    "policy"
  ],
  "allowed_roles": ["USER", "AGENT", "MANAGER"],
  "tools": [
    "lookup_order",
    "validate_return",
    "inspect_return_inventory",
    "check_risk_level",
    "execute_refund",
    "restore_return_inventory",
    "reverse_inventory_movement",
    "erp_query_doctype",
    "send_notification"
  ],
  "policies": ["refund_review"],
  "hitl": {
    "enabled": true,
    "review_roles": ["MANAGER"],
    "description": "High-risk refunds are interrupted before execution and wait for manager approval.",
    "approval_chain": [
      {
        "id": "manager_review",
        "name": "Manager review",
        "roles": ["MANAGER"],
        "required": true
      }
    ]
  },
  "runtime": {
    "schema_version": "3",
    "engine": "langgraph",
    "entry_node": "classify_intent",
    "nodes": [
      { "id": "classify_intent", "handler": "classify_intent" },
      { "id": "answer_node", "handler": "answer_node" },
      { "id": "answer_tools", "handler": "answer_tools" },
      { "id": "policy_qa_agent", "handler": "policy_qa_specialist" },
      { "id": "dynamic_dispatch", "handler": "dynamic_plan_dispatch" },
      { "id": "summarize_session", "handler": "summarize_session" }
    ],
    "edges": [
      { "from": "answer_tools", "to": "answer_node" },
      { "from": "policy_qa_agent", "to": "$end" },
      { "from": "summarize_session", "to": "$end" }
    ],
    "conditional_edges": [
      {
        "from": "classify_intent",
        "router": "refund_after_classify",
        "routes": {
          "dynamic_dispatch": "dynamic_dispatch",
          "answer_node": "answer_node",
          "policy_qa_agent": "policy_qa_agent"
        }
      },
      {
        "from": "answer_node",
        "router": "answer_after_model",
        "routes": {
          "tools": "answer_tools",
          "summarize": "summarize_session"
        }
      },
      {
        "from": "dynamic_dispatch",
        "router": "dynamic_plan_step",
        "routes": {
          "dynamic_dispatch": "dynamic_dispatch",
          "summarize_session": "summarize_session"
        }
      }
    ]
  }
}
